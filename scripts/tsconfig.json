{
  // Used by the tsx-run scripts (`npm run populateLearningResources`,
  // `npm run cleanupGuests`), which run outside Vite. SvelteKit's virtual
  // `$env/*` and `$app/*` modules don't exist there, so map the ones
  // `$lib/prisma` needs to a shim. Railway injects the service's variables
  // into process.env.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["../src/lib"],
      "$lib/*": ["../src/lib/*"],
      "$env/dynamic/private": ["./env-shim.ts"],
      "$app/environment": ["./env-shim.ts"]
    }
  }
}
