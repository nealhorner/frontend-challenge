{
  // Used by the tsx-run scripts (`npm run populateLearningResources`,
  // `npm run cleanupGuests`), which run outside Vite. SvelteKit's virtual
  // `$env/*` modules don't exist there, so map the one `$lib/prisma` needs to a
  // process.env shim. Railway injects the service's variables into process.env.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["../src/lib"],
      "$lib/*": ["../src/lib/*"],
      "$env/dynamic/private": ["./env-shim.ts"]
    }
  }
}
