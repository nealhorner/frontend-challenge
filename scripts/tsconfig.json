{
  // Used by the tsx-run scripts (seed, populateLearningResources,
  // cleanupGuests), which run outside Vite. Map $lib so they can share app
  // code. They run under `varlock run`, which loads and validates the env from
  // .env.schema so `varlock/env` works.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["../src/lib"],
      "$lib/*": ["../src/lib/*"]
    }
  }
}
