{
  "name": "frontend-challenge",
  "version": "0.1.1",
  "scripts": {
    "dev": "vite dev",
    "start": "varlock run -- node build",
    "build": "prisma generate && vite build",
    "release": "varlock run -- prisma migrate deploy && npm run populateLearningResources",
    "preview": "varlock run -- vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "audit:contrast": "playwright test -c playwright.audit.config.ts",
    "check:version": "git fetch --no-tags origin main && node scripts/check-version-bump.mjs origin/main",
    "populateLearningResources": "varlock run -- tsx --tsconfig scripts/tsconfig.json scripts/populate-open-graph.ts",
    "cleanupGuests": "varlock run -- tsx --tsconfig scripts/tsconfig.json scripts/cleanup-guests.ts",
    "db:migrate": "varlock run -- prisma migrate dev",
    "db:seed": "varlock run -- tsx --tsconfig scripts/tsconfig.json prisma/seed.ts",
    "db:ui": "varlock run -- prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/mdi": "^1.1.66",
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "@varlock/vite-integration": "^1.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.2.6",
    "prisma": "^7.8.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2",
    "unplugin-icons": "^0.19.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "prisma": {
    "seed": "varlock run -- tsx --tsconfig scripts/tsconfig.json prisma/seed.ts"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "@hono/node-server": "^1.19.13"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/sveltekit": "^10.0.0",
    "better-auth": "^1.6.22",
    "isomorphic-dompurify": "^2.21.0",
    "lucide-svelte": "^1.0.1",
    "resend": "^6.12.4",
    "tsx": "^4.10.2",
    "varlock": "^1.23.0"
  }
}
