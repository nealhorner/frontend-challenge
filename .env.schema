# Environment schema for Frontend Challenge, read by Varlock (https://varlock.dev).
#
# This file is committed: it declares every variable the app reads, with its
# type and whether it's required or secret. Values go in .env.local (or .env)
# for local dev, and in Railway's service variables in staging/production.
# Real environment variables always override values from files.
#
# Check your setup with: npx varlock load
#
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @generateTsTypes(path=./src/env.d.ts)
# ---

# Set by the tooling (Vite, Node); only needed to override it.
# @type=enum(development, test, production) @public
NODE_ENV=

# --- Database ---

# Postgres connection string. On Railway, reference the Postgres service:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
# @required @type=url(allowedProtocols=[postgres, postgresql])
# @example="postgresql://postgres:postgres@localhost:55432/appdb?schema=public"
DATABASE_URL=

# --- BetterAuth ---

# Signs sessions and tokens. Use a different value in each environment.
# Generate with: openssl rand -base64 32
# @required @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public base URL of the app, used for OAuth callbacks, email links and
# redirects. Must match the address people visit (and the dev server port).
# @required @type=url
# @example="http://localhost:5173"
BETTER_AUTH_URL=

# Skip email verification on sign-up. Only for the e2e tests; never in production.
# @type=boolean @public @dynamic
REQUIRE_EMAIL_VERIFICATION=true

# Turn off BetterAuth's rate limiting. Only for the e2e tests; never in production.
# @type=boolean @public @dynamic
AUTH_DISABLE_RATE_LIMIT=false

# OAuth provider credentials. Each provider's "Continue with …" button only
# appears when both its client ID and secret are set; email/password works
# without them. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/<provider>
# Client IDs aren't secret (they appear in every sign-in redirect URL), so
# they're public; the client secrets stay sensitive.
# @public @dynamic
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# @public @dynamic
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---

# API key from resend.com. Needed for verification and feedback emails.
# @type=string(startsWith=re_)
RESEND_API_KEY=

# Sender shown on outgoing emails. Must be on a domain verified in Resend.
# @example="Frontend Challenge <noreply@frontendchallenge.dev>"
EMAIL_FROM=

# Where feedback submissions are sent.
# @type=email
FEEDBACK_EMAIL=

# --- Monitoring (Sentry) ---

# Build-time: inlined into the client and server bundles by `vite build`, so
# changing it needs a redeploy.
# @type=url
PUBLIC_SENTRY_DSN=

# Build-time only: uploads source maps during `vite build`. The build still
# succeeds without it, but the upload is skipped.
SENTRY_AUTH_TOKEN=

# --- Deployment ---

# Public origin of the deployed app, used by @sveltejs/adapter-node behind
# Railway's proxy so form actions aren't rejected as cross-site. Same address
# as BETTER_AUTH_URL.
# @type=url
ORIGIN=
